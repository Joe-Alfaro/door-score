# Copy to .env and fill in. The parcel stage needs no keys at all.
ANTHROPIC_API_KEY=        # vision + source discovery (Claude)
GOOGLE_MAPS_API_KEY=      # Street View Static API (enable it on the key; ~$7 per 1k images)
CENSUS_API_KEY=           # free, instant: https://api.census.gov/data/key_signup.html

# Console API (pipeline/doorscore/api.py) — all optional
CONSOLE_TOKEN=            # required in X-Console-Token for POST /api/run/* and /api/runs/*/cancel. Unset = mutations only from localhost
MAX_SPEND_USD=45          # refuse to start a paid stage if ledger total + estimate would exceed this
WEB_URL=                  # map deployment pinged by /api/status (default: the live Railway URL)
MCP_URL=                  # MCP server used by /api/route and /api/mcp/tools (default: the live Railway URL)
