.venv/
__pycache__/
*.pyc
node_modules/
dist/
.env
# Image caches are large and re-fetchable; JSON caches are committed so nobody re-pays for LLM calls.
data/cache/streetview/
data/cache/satellite/
data/cache/runs/
data/raw/

# Street View imagery is Google content: never committed or re-served; displayed via proxy at view time
web/public/img/
data/eval/images/
data/eval/satellite/images/
data/cache/satellite_outlined/
data/territories/

# No default area or per-home output is committed: users draw their own area (POST /api/territory).
data/territory.geojson
data/territory_preview.html
data/out/doors.json
data/out/doors.geojson
data/out/run_report.json
data/cache/parcels_*.geojson
data/cache/streetview_meta/
mcp/data/
web/public/data/
